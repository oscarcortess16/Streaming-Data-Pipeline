from pyspark.sql import functions as F
from pyspark.sql import types as T
from pyspark.sql.window import Window

# 1. Lectura limpia (sin inferSchema innecesario para tablas del catálogo)
df = (
    spark.readStream
    .format("cloudFiles")
    .option("cloudFiles.format", "csv")
    .option("header", "true")
    .option("cloudFiles.schemaLocation", "dbfs:/schemas/transactions")
    .load("s3://oscar-ingestion-data/transactions/")
)

(
    df.writeStream
    .format("delta")
    .option("checkpointLocation", "dbfs:/checkpoints/transactions") 
    .trigger(processingTime="1 minute")
    .toTable("data_ingestion.`01_bronze`")
)

# Renombrar columnas de una sola vez
df_renamed = df.select(
    F.col('sls_ord_num').alias('order_number'),
    F.col('sls_prd_key').alias('product_key'),
    F.col('sls_cust_id').alias('customer_id'),
    F.col('sls_order_dt').alias('order_datetime'),
    F.col('sls_ship_dt').alias('ship_datetime'),
    F.col('sls_due_dt').alias('due_datetime'),
    F.col('sls_sales').alias('sales'),
    F.col('sls_quantity').alias('quantity'),
    F.col('sls_price').alias('price')
)

def normalize_text_cols(df):
    return (df
            .withColumn('order_number', F.upper(F.trim(F.col('order_number'))))
            .withColumn('product_key', F.upper(F.trim(F.col('product_key')))))

def parsing_columns(df):
    return (df
            .withColumn('order_datetime', F.try_to_date(F.col('order_datetime').cast('string'), 'yyyyMMdd'))
            .withColumn('ship_datetime', F.try_to_date(F.col('ship_datetime').cast('string'), 'yyyyMMdd'))
            .withColumn('due_datetime', F.try_to_date(F.col('due_datetime').cast('string'), 'yyyyMMdd')))

def integer_columns(df):
    # Nota: Si son importes decimales, considera usar .cast(T.DecimalType(10, 2)) en vez de asumir enteros
    return (df
            .withColumn('sales', F.abs(F.col('sales')))
            .withColumn('quantity', F.abs(F.col('quantity')))
            .withColumn('price', F.abs(F.col('price'))))

def apply_business_rules(df):
    # Corrección: Establecemos que 'price' y 'quantity' son la verdad absoluta. 
    # Si sales no cuadra, recalculamos sales. Evitamos la lógica circular.
    is_discrepancy = F.col('sales') != (F.col('price') * F.col('quantity'))
    return df.withColumn('sales', F.when(is_discrepancy, F.col('price') * F.col('quantity')).otherwise(F.col('sales')))
    
def add_quality_flags(df):
    order_number_format = r'^SO[0-9]{5}'
    product_key_format = r"^[A-Za-z]{2}-.*$"
    customer_id_format = r'[0-9]{5}'

    # Agrupamos las validaciones en un solo flag final de forma más eficiente
    return (
        df
        .withColumn('is_valid_order_number', F.col('order_number').isNotNull() & F.col('order_number').rlike(order_number_format))
        .withColumn('is_valid_product_key', F.col('product_key').isNotNull() & F.col('product_key').rlike(product_key_format))
        .withColumn('is_valid_customer_id', F.col('customer_id').isNotNull() & F.col('customer_id').rlike(customer_id_format))
        .withColumn('is_valid_datetime', 
                    F.col('order_datetime').isNotNull() & 
                    F.col('ship_datetime').isNotNull() & 
                    F.col('due_datetime').isNotNull() & 
                    (F.col('order_datetime') <= F.col('ship_datetime')) & 
                    (F.col('ship_datetime') <= F.col('due_datetime')))
        .withColumn('is_valid_quantity', F.col('quantity').isNotNull() & (F.col('quantity') > 0))
        .withColumn('is_valid_sales', F.col('sales').isNotNull() & (F.col('sales') > 0))
        .withColumn('is_valid_price', F.col('price').isNotNull() & (F.col('price') > 0))
        .withColumn('valid_record', 
                    F.col('is_valid_order_number') & 
                    F.col('is_valid_product_key') & 
                    F.col('is_valid_customer_id') & 
                    F.col('is_valid_datetime') & 
                    F.col('is_valid_quantity') & 
                    F.col('is_valid_sales') & 
                    F.col('is_valid_price'))
    )

def remove_duplicates(df):
    window_spec = Window.partitionBy('order_number', 'product_key').orderBy('order_datetime')
    return (df
            .withColumn('row_number', F.row_number().over(window_spec))
            .filter(F.col('row_number') == 1)
            .drop('row_number'))

# === PIPELINE PRINCIPAL UNIFICADO ===

# Aplicamos todo el procesamiento base UNA SOLA VEZ
df_processed = (
    df_renamed
    .transform(normalize_text_cols)
    .transform(parsing_columns)
    .transform(integer_columns)
    .transform(apply_business_rules)
    .transform(add_quality_flags)
    .transform(remove_duplicates)
)

# PERSISTENCIA EN MEMORIA: Evita que Spark recalcule todo el árbol para los conteos y divisiones posteriores
df_processed.cache()

# Separación de ramificaciones (Split)
clean_flags = ['valid_record', 'is_valid_order_number', 'is_valid_product_key', 'is_valid_customer_id', 'is_valid_datetime', 'is_valid_quantity', 'is_valid_sales', 'is_valid_price']

clean_df = df_processed.filter(F.col('valid_record') == True).drop(*clean_flags)

quarantine_df = (
    df_processed
    .filter(F.col('valid_record') == False)
    .withColumn('quarantine_reason', 
                F.when(~F.col('is_valid_order_number'), 'Invalid order number')
                .when(~F.col('is_valid_product_key'), 'Invalid product key')
                .when(~F.col('is_valid_customer_id'), 'Invalid customer id')
                .when(~F.col('is_valid_datetime'), 'Invalid datetime')
                .when(~F.col('is_valid_quantity'), 'Invalid quantity')
                .when(~F.col('is_valid_sales'), 'Invalid sales')
                .when(~F.col('is_valid_price'), 'Invalid price')
                .otherwise('Unknown Error'))
)

# === MÉTRICAS Y SHOW (Ahora van súper rápido gracias al cache) ===

print("=== Sample Quarantine Records ===")
quarantine_df.select('order_number', 'product_key', 'customer_id', 'order_datetime', 'quarantine_reason').show(20, truncate=False)

print("\n=== Quarantine Breakdown ===")
quarantine_df.groupBy('quarantine_reason').count().orderBy(F.desc('count')).show(truncate=False)

total_source = df.count()
total_clean = clean_df.count()
total_quarantine = quarantine_df.count()

print(f"\n=== Summary ===")
print(f"Total source records: {total_source}")
print(f"Total clean records: {total_clean}")
print(f"Total quarantine records: {total_quarantine}")
print(f"Clean percentage: {(total_clean/total_source)*100:.2f}%")
print(f"Quarantine percentage: {(total_quarantine/total_source)*100:.2f}%")
